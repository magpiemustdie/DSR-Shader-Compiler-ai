<Window x:Class="ShaderCompiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSR Shader Compiler" Height="860" Width="860"
        ResizeMode="CanResizeWithGrip"
        MinWidth="760" MinHeight="620">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Settings ══════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="0" Header="Settings" Margin="0,0,0,6">
            <StackPanel Margin="6,4,6,4">

                <!-- Core paths — always visible -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="66"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DSR game folder"       VerticalAlignment="Center" Margin="0,2"
                               ToolTip="Path to DarkSoulsRemastered folder (contains DarkSoulsRemastered.exe)"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtDSR"              Margin="6,2" VerticalContentAlignment="Center"/>
                    <Button    Grid.Row="0" Grid.Column="2"                               Margin="0,2" Content="Browse…" Click="BrowseDSR_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="fxc 8.1  (Win 8.1 SDK)" VerticalAlignment="Center" Margin="0,2"
                               ToolTip="fxc.exe v6.3.9600.16384 — matches original DSR compiler. Used by Build All."/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtFXC81"            Margin="6,2" VerticalContentAlignment="Center"/>
                    <Button    Grid.Row="1" Grid.Column="2"                               Margin="0,2" Content="Browse…" Click="BrowseFXC81_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Shader source folder"  VerticalAlignment="Center" Margin="0,2"
                               ToolTip="Folder with HLSL source subfolders: FRPG_FlverPBL, FRPG_Filter, FRPG_Menu …"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtSource"           Margin="6,2" VerticalContentAlignment="Center"/>
                    <Button    Grid.Row="2" Grid.Column="2"                               Margin="0,2" Content="Browse…" Click="BrowseSource_Click"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Original shaders"      VerticalAlignment="Center" Margin="0,2"
                               ToolTip="Folder with vanilla .shaderbnd.dcx files — used by 'Restore Original' button"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtOriginal"         Margin="6,2" VerticalContentAlignment="Center"/>
                    <Button    Grid.Row="3" Grid.Column="2"                               Margin="0,2" Content="Browse…" Click="BrowseOriginal_Click"/>
                </Grid>

                <!-- Advanced (collapsed by default) -->
                <Expander Header="Advanced / Reference platforms" Margin="0,6,0,0" IsExpanded="False">
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="66"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,2" Foreground="Gray">
                            <Run Text="fxc.exe" FontWeight="SemiBold"/><Run Text=" (new SDK, v10)"/>
                        </TextBlock>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtFXC"          Margin="6,2" VerticalContentAlignment="Center"/>
                        <Button    Grid.Row="0" Grid.Column="2"                           Margin="0,2" Content="Browse…" Click="BrowseFXC_Click"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,2" Foreground="Gray">
                            <Run Text="PTDE shaders" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtPTDEShaders"  Margin="6,2" VerticalContentAlignment="Center"/>
                        <Button    Grid.Row="1" Grid.Column="2"                           Margin="0,2" Content="Browse…" Click="BrowsePTDEShaders_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,2" Foreground="Gray">
                            <Run Text="Switch shaders" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtSwitchShaders" Margin="6,2" VerticalContentAlignment="Center"/>
                        <Button    Grid.Row="2" Grid.Column="2"                            Margin="0,2" Content="Browse…" Click="BrowseSwitchShaders_Click"/>
                    </Grid>
                </Expander>

                <!-- Hidden legacy -->
                <TextBox x:Name="TxtPTDE"       Visibility="Collapsed"/>
                <TextBox x:Name="TxtDSRShaders" Visibility="Collapsed"/>
            </StackPanel>
        </GroupBox>

        <!-- ══ Tabs ═══════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1" Margin="0,0,0,6">

            <!-- ── Compile ── -->
            <TabItem Header="  Compile  ">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Targets" Margin="0,0,0,6">
                        <StackPanel Margin="4,6,4,4">

                            <!-- 7 archives -->
                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox x:Name="ChkFlver"    Content="FlverPBL  fpo" FontWeight="SemiBold"
                                          IsChecked="True" Margin="0,0,16,4" VerticalAlignment="Center"
                                          ToolTip="FRPG_FlverPBL_fpo_DX11.shaderbnd.dcx&#x0a;~1989 pixel shaders (Phn/Gst/Sfx/Snow/Water/Non/Misc)"/>
                                <CheckBox x:Name="ChkFlverVS"  Content="FlverPBL  vpo" FontWeight="SemiBold"
                                          IsChecked="True" Margin="0,0,16,4" VerticalAlignment="Center"
                                          ToolTip="FRPG_FlverPBL_vpo_DX11.shaderbnd.dcx&#x0a;676 vertex shaders"/>
                                <CheckBox x:Name="ChkFilter"   Content="Filter"        FontWeight="SemiBold"
                                          IsChecked="False" Margin="0,0,16,4" VerticalAlignment="Center"
                                          ToolTip="FRPG_Filter_DX11.shaderbnd.dcx&#x0a;DoF / HDR / MotionBlur / SAO / SSAO / Misc (~116 fpo+vpo+cpo)"/>
                                <CheckBox x:Name="ChkMenu"     Content="Menu"          FontWeight="SemiBold"
                                          IsChecked="False" Margin="0,0,16,4" VerticalAlignment="Center"
                                          ToolTip="FRPG_Menu_DX11.shaderbnd.dcx&#x0a;6 shaders"/>
                                <CheckBox x:Name="ChkSfxPBL"   Content="SfxPBL"       FontWeight="SemiBold"
                                          IsChecked="False" Margin="0,0,16,4" VerticalAlignment="Center"
                                          ToolTip="FRPG_SfxPBL_DX11.shaderbnd.dcx&#x0a;Blur / Tracer / Distortion / Sprites / Particles (34 fpo + 29 vpo)"/>
                                <CheckBox x:Name="ChkDeferred" Content="Deferred"      FontWeight="SemiBold"
                                          IsChecked="False" Margin="0,0,16,4" VerticalAlignment="Center"
                                          ToolTip="FRPG_Deferred_DX11.shaderbnd.dcx&#x0a;LightProbe / PointLight / DebugGBuffer (6 shaders)"/>
                                <CheckBox x:Name="ChkDbgFont"  Content="DbgFont"       FontWeight="SemiBold"
                                          IsChecked="False" Margin="0,0,0,4" VerticalAlignment="Center"
                                          ToolTip="DbgFont_DX11.shaderbnd.dcx&#x0a;Debug font + primitives (8 shaders)"/>
                            </WrapPanel>

                            <!-- Options -->
                            <WrapPanel Margin="0,0,0,4">
                                <CheckBox x:Name="ChkForce" Content="Force rebuild"
                                          IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"
                                          ToolTip="Recompile even if output is newer than source"/>
                                <CheckBox x:Name="ChkUseFxc81ForBuild" Content="Use fxc 8.1"
                                          IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"
                                          ToolTip="Use fxc v6.3.9600 — matches original DSR compiler (recommended)"/>
                                <CheckBox x:Name="ChkPackAfterBuild" Content="Pack after build"
                                          IsChecked="True" VerticalAlignment="Center"
                                          ToolTip="After compiling, repacks the .shaderbnd.dcx in DSR\shader\"/>
                            </WrapPanel>

                        </StackPanel>
                    </GroupBox>

                    <!-- Log -->
                    <TextBox x:Name="TxtLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#1e1e1e" Foreground="#d4d4d4"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MinHeight="80"/>
                </Grid>
            </TabItem>

            <!-- ── Bundles ── -->
            <TabItem Header="  Bundles  ">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Unpack -->
                    <GroupBox Grid.Row="0" Header="Unpack  .shaderbnd.dcx  →  folder" Margin="0,0,0,6">
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox   Grid.Column="0" x:Name="TxtUnpackSrc" Margin="0,0,4,0"
                                       VerticalContentAlignment="Center" IsReadOnly="True" Background="#f5f5f5"
                                       ToolTip="Path to .shaderbnd.dcx to unpack"/>
                            <Button    Grid.Column="1" Content="Browse…" Margin="0,0,4,0" Click="BrowseUnpackSrc_Click"/>
                            <Button    Grid.Column="2" Content="Unpack →  folder" Click="Unpack_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- Pack -->
                    <GroupBox Grid.Row="1" Header="Pack  folder  →  .shaderbnd.dcx" Margin="0,0,0,6">
                        <Grid Margin="6,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Folder with .fpo:" VerticalAlignment="Center" Margin="0,2"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtPackSrcDir"   Margin="4,2"
                                       VerticalContentAlignment="Center" IsReadOnly="True" Background="#f5f5f5"/>
                            <Button    Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="0,2" Click="BrowsePackSrcDir_Click"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Template bundle:"  VerticalAlignment="Center" Margin="0,2"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtPackTemplate" Margin="4,2"
                                       VerticalContentAlignment="Center" IsReadOnly="True" Background="#f5f5f5"
                                       ToolTip="Original .shaderbnd.dcx — used as template, will be overwritten"/>
                            <Button    Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="0,2" Click="BrowsePackTemplate_Click"/>

                            <Button    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                       Content="Pack folder → .shaderbnd.dcx" Height="28" Margin="0,6,0,0"
                                       Click="Pack_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- Quick access -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="Quick select" Margin="0,0,0,6">
                            <StackPanel Margin="4,4">
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="FlverPBL fpo" Width="110" Margin="0,0,6,4" Tag="FRPG_FlverPBL_fpo_DX11.shaderbnd.dcx" Click="QuickBundle_Click"/>
                                    <Button Content="FlverPBL vpo" Width="110" Margin="0,0,6,4" Tag="FRPG_FlverPBL_vpo_DX11.shaderbnd.dcx" Click="QuickBundle_Click"/>
                                    <Button Content="Filter"       Width="90"  Margin="0,0,6,4" Tag="FRPG_Filter_DX11.shaderbnd.dcx"       Click="QuickBundle_Click"/>
                                    <Button Content="Menu"         Width="70"  Margin="0,0,6,4" Tag="FRPG_Menu_DX11.shaderbnd.dcx"         Click="QuickBundle_Click"/>
                                    <Button Content="SfxPBL"       Width="80"  Margin="0,0,6,4" Tag="FRPG_SfxPBL_DX11.shaderbnd.dcx"      Click="QuickBundle_Click"/>
                                    <Button Content="Deferred"     Width="80"  Margin="0,0,6,4" Tag="FRPG_Deferred_DX11.shaderbnd.dcx"    Click="QuickBundle_Click"/>
                                    <Button Content="DbgFont"      Width="80"  Margin="0,0,0,4" Tag="DbgFont_DX11.shaderbnd.dcx"           Click="QuickBundle_Click"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="Restore FlverPBL from .bak" Width="200" Margin="0,0,6,0"
                                            Tag="FRPG_FlverPBL_fpo_DX11.shaderbnd.dcx" Click="RestoreFromBak_Click"
                                            Background="#fff3cd" ToolTip="Copies .shaderbnd.dcx.bak → .shaderbnd.dcx"/>
                                    <Button Content="Decompile all bundles" Width="180" Margin="0,0,6,0"
                                            Click="DecompileAllBundles_Click"
                                            Background="#d4edda" ToolTip="Unpack all DX11 bundles + translate to HLSL in reference/decompiled/"/>
                                    <Button Content="Decompile PTDE" Width="140" Margin="0,0,6,0"
                                            Click="DecompilePtdeBundle_Click"
                                            Background="#cce5ff"/>
                                    <Button Content="Decompile all PTDE" Width="150" Margin="0,0,6,0"
                                            Click="DecompileAllPtdeBundles_Click"
                                            Background="#cce5ff"/>
                                    <Button Content="Extract MTD" Width="120"
                                            Click="ExtractMtd_Click"
                                            Background="#e2d9f3" ToolTip="Extract MTD material definitions → mtd/"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <TextBox x:Name="TxtBundleLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" Background="#1e1e1e" Foreground="#d4d4d4"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── Activate / Restore ── -->
            <TabItem Header="  Activate  ">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Activate shaders in game  (Original ↔ Compiled)" Margin="0,0,0,6">
                        <Grid Margin="4,4,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="Gray" FontSize="11"
                                       Text="◀ Restore original — copies vanilla .shaderbnd.dcx from 'Original shaders' folder into DSR\shader\.&#x0a;Activate compiled ▶ — packs compiled shaders from unpacked folder back into DSR\shader\."/>

                            <StackPanel Grid.Row="1">
                                <!-- Header -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bundle" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
                                    <TextBlock Grid.Column="1" Text="Restore original" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Activate compiled" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- Per-bundle rows -->
                                <ItemsControl>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate/>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Manual rows -->
                                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FlverPBL fpo" VerticalAlignment="Center" Margin="4,0" FontFamily="Consolas" FontSize="11"/>
                                    <Button Grid.Column="1" Content="◀ Restore" Margin="2,0,2,0" Background="#fff3cd" Tag="FRPG_FlverPBL_fpo_DX11.shaderbnd.dcx" Click="UseOriginal_Click"/>
                                    <Button Grid.Column="2" Content="Activate ▶" Margin="2,0"     Background="#d4edda" Tag="FRPG_FlverPBL_fpo_DX11.shaderbnd.dcx" Click="UseModded_Click"/>
                                </Grid>
                                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FlverPBL vpo" VerticalAlignment="Center" Margin="4,0" FontFamily="Consolas" FontSize="11"/>
                                    <Button Grid.Column="1" Content="◀ Restore" Margin="2,0,2,0" Background="#fff3cd" Tag="FRPG_FlverPBL_vpo_DX11.shaderbnd.dcx" Click="UseOriginal_Click"/>
                                    <Button Grid.Column="2" Content="Activate ▶" Margin="2,0"     Background="#d4edda" Tag="FRPG_FlverPBL_vpo_DX11.shaderbnd.dcx" Click="UseModded_Click"/>
                                </Grid>
                                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Filter"       VerticalAlignment="Center" Margin="4,0" FontFamily="Consolas" FontSize="11"/>
                                    <Button Grid.Column="1" Content="◀ Restore" Margin="2,0,2,0" Background="#fff3cd" Tag="FRPG_Filter_DX11.shaderbnd.dcx"        Click="UseOriginal_Click"/>
                                    <Button Grid.Column="2" Content="Activate ▶" Margin="2,0"     Background="#d4edda" Tag="FRPG_Filter_DX11.shaderbnd.dcx"        Click="UseModded_Click"/>
                                </Grid>
                                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Menu"         VerticalAlignment="Center" Margin="4,0" FontFamily="Consolas" FontSize="11"/>
                                    <Button Grid.Column="1" Content="◀ Restore" Margin="2,0,2,0" Background="#fff3cd" Tag="FRPG_Menu_DX11.shaderbnd.dcx"          Click="UseOriginal_Click"/>
                                    <Button Grid.Column="2" Content="Activate ▶" Margin="2,0"     Background="#d4edda" Tag="FRPG_Menu_DX11.shaderbnd.dcx"          Click="UseModded_Click"/>
                                </Grid>
                                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SfxPBL"       VerticalAlignment="Center" Margin="4,0" FontFamily="Consolas" FontSize="11"/>
                                    <Button Grid.Column="1" Content="◀ Restore" Margin="2,0,2,0" Background="#fff3cd" Tag="FRPG_SfxPBL_DX11.shaderbnd.dcx"       Click="UseOriginal_Click"/>
                                    <Button Grid.Column="2" Content="Activate ▶" Margin="2,0"     Background="#d4edda" Tag="FRPG_SfxPBL_DX11.shaderbnd.dcx"       Click="UseModded_Click"/>
                                </Grid>

                                <Separator Margin="0,8,0,6"/>

                                <!-- All -->
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="All bundles" VerticalAlignment="Center" Margin="4,0" FontStyle="Italic" FontWeight="SemiBold"/>
                                    <Button Grid.Column="1" Content="◀◀ Restore all" Margin="2,0,2,0" Background="#fff3cd"
                                            Click="AllOriginal_Click" ToolTip="Restore all bundles from original folder"/>
                                    <Button Grid.Column="2" Content="Activate all ▶▶" Margin="2,0" Background="#d4edda"
                                            Click="AllModded_Click" ToolTip="Activate all compiled bundles"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <TextBox x:Name="TxtSwitchLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#1e1e1e" Foreground="#d4d4d4"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <!-- ── Decompile ── -->
            <TabItem Header="  Decompile  ">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Single file" Margin="0,0,0,6">
                        <WrapPanel Margin="4">
                            <Button Content="Disassemble .fpo → .asm"       Width="190" Margin="0,0,8,4" Click="DisasmSingle_Click"/>
                            <Button Content="Decompile .fpo → HLSL skeleton" Width="210" Margin="0,0,8,4" Click="DecompileSingle_Click"/>
                            <Button Content="Translate .asm → HLSL"          Width="170" Margin="0,0,0,4" Click="TranslateAsm_Click"/>
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Compile HLSL → .fpo / .vpo" Margin="0,0,0,6">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="HLSL:"   VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtCompileIn"  Margin="4,2" VerticalContentAlignment="Center"/>
                            <Button    Grid.Row="0" Grid.Column="2"                          Margin="0,2" Content="Browse…" Click="BrowseCompileIn_Click"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Output:" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtCompileOut" Margin="4,2" VerticalContentAlignment="Center"/>
                            <Button    Grid.Row="1" Grid.Column="2"                          Margin="0,2" Content="Browse…" Click="BrowseCompileOut_Click"/>

                            <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Profile:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox  Grid.Column="1" x:Name="CmbProfile" Width="80" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="ps_5_0"/>
                                    <ComboBoxItem Content="vs_5_0"/>
                                    <ComboBoxItem Content="cs_5_0"/>
                                    <ComboBoxItem Content="gs_5_0"/>
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="Entry:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox   Grid.Column="3" x:Name="TxtEntry" Text="main" Width="80" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="4" x:Name="TxtCompileStatus" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                                <Button    Grid.Column="5" Content="Compile" Width="80" Click="CompileHlsl_Click"/>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="Batch decompile (folder of .fpo/.vpo)" Margin="0,0,0,6">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Input:"  VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtDecompIn"  Margin="4,2" VerticalContentAlignment="Center"/>
                            <Button    Grid.Row="0" Grid.Column="2"                         Margin="0,2" Content="Browse…" Click="BrowseDecompIn_Click"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Output:" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtDecompOut" Margin="4,2" VerticalContentAlignment="Center"/>
                            <Button    Grid.Row="1" Grid.Column="2"                         Margin="0,2" Content="Browse…" Click="BrowseDecompOut_Click"/>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox x:Name="ChkTranslate" Content="Also translate to HLSL" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <Button x:Name="BtnBatchDecomp" Content="Batch decompile" Width="130" Click="BatchDecomp_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <TextBox x:Name="TxtDecompLog" Grid.Row="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#1e1e1e" Foreground="#d4d4d4"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <!-- ── Reference ── -->
            <TabItem Header="  Reference  ">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Margin="0,0,0,6" Foreground="Gray" FontSize="10"
                                   Text="Unpack and disassemble original shader archives into reference\ subfolders.&#x0a;Structure: reference\DSR_Windows\  |  reference\PTDE_Windows\  |  reference\DSR_Switch\"/>

                        <GroupBox Header="DSR Windows  (.shaderbnd.dcx)" Margin="0,0,0,6" BorderBrush="#0055aa">
                            <Grid Margin="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="Gray"
                                           Text="Source: DSR shaders folder  →  reference\DSR_Windows\"/>
                                <CheckBox  Grid.Column="1" x:Name="ChkRefDSRDisasm" Content="Disassemble" IsChecked="True" VerticalAlignment="Center" Margin="8,0"/>
                                <Button    Grid.Column="2" Content="Unpack DSR → reference" Width="190" Click="UnpackDSRToReference_Click" Background="#d4edda"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="PTDE Windows  (.shaderbnd)" Margin="0,0,0,6" BorderBrush="#0055aa">
                            <Grid Margin="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="Gray"
                                           Text="Source: PTDE shaders folder  →  reference\PTDE_Windows\"/>
                                <CheckBox  Grid.Column="1" x:Name="ChkRefPTDEDisasm" Content="Disassemble" IsChecked="True" VerticalAlignment="Center" Margin="8,0"/>
                                <Button    Grid.Column="2" Content="Unpack PTDE → reference" Width="190" Click="UnpackPTDEToReference_Click" Background="#cce5ff"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="DSR Switch  (.fpo binaries)" Margin="0,0,0,6" BorderBrush="#0055aa">
                            <Grid Margin="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="Gray"
                                           Text="Source: Switch shaders folder  →  reference\DSR_Switch\"/>
                                <CheckBox  Grid.Column="1" x:Name="ChkRefSwitchDisasm" Content="Try disassemble" IsChecked="True" VerticalAlignment="Center" Margin="8,0"/>
                                <Button    Grid.Column="2" Content="Copy Switch → reference" Width="190" Click="CopySwitchToReference_Click" Background="#f8d7da"/>
                            </Grid>
                        </GroupBox>

                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Unpack ALL platforms" Width="190" Margin="0,0,8,0"
                                    Click="UnpackAllToReference_Click" Background="#d4edda" FontWeight="SemiBold"/>
                            <Button Content="Clear reference\" Width="150"
                                    Click="ClearReference_Click" Background="#fff3cd"/>
                        </WrapPanel>
                    </StackPanel>

                    <TextBox x:Name="TxtRefLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#1e1e1e" Foreground="#d4d4d4"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ══ Bottom bar ═════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="Progress"  Grid.Column="0" Height="26" Margin="0,0,8,0" Minimum="0" Maximum="100"/>
            <TextBlock   x:Name="TxtStatus" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" Width="100" TextAlignment="Right" FontSize="11"/>

            <!-- Build All — главная кнопка -->
            <Button x:Name="BtnBuildAll" Grid.Column="2"
                    Content="🔨 Build All (clean)"
                    Width="150" Height="30" Margin="0,0,6,0"
                    FontWeight="SemiBold" FontSize="12"
                    Background="#2d7d2d" Foreground="White"
                    Click="BuildAll_Click"
                    ToolTip="Compile ALL 7 DX11 archives from source using fxc 8.1 + pack. No originals needed.">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="3" BorderThickness="1"
                                            BorderBrush="#1a5c1a">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#388e3c"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#1b5e20"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Build partial -->
            <Button x:Name="BtnBuild" Grid.Column="3"
                    Content="Build…" Width="80" Height="30"
                    Click="Build_Click"
                    ToolTip="Compile selected targets only (use checkboxes in Compile tab)"/>
        </Grid>
    </Grid>
</Window>
