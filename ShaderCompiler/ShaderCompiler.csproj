<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>ShaderCompiler</AssemblyName>
    <RootNamespace>ShaderCompiler</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude standalone CLI Program.cs — it conflicts with the WPF namespace -->
    <Compile Remove="Program.cs" />
    <Compile Remove="TestTranslator.cs" />
    <!-- Exclude TranslatorTest — it's a separate console project in tools/ -->
    <Compile Remove="../tools/TranslatorTest/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\source\repos\SoulsFormatsNEXT\SoulsFormats\SoulsFormats.csproj" />
  </ItemGroup>
</Project>
